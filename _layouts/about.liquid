---
layout: default
---
<div class="academic-home">
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">Machine learning &amp; computational biology</p>
      <h1 id="intro-title">Ke Xu <span lang="zh">许可</span></h1>
      <p class="intro-role">PhD student in Computer Science <span aria-hidden="true">/</span> Yale University</p>
      <p class="intro-lead">Learning how biological systems change.</p>
      <div class="intro-bio">{{ content }}</div>
      <nav class="profile-links" aria-label="Academic profiles">
        <a href="mailto:{{ site.email | encode_email }}">Email <span aria-hidden="true">↗</span></a>
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/{{ site.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
        <a href="{{ '/cv/' | relative_url }}">CV <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <figure class="intro-portrait">
      <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Ke Xu" width="1924" height="1280" fetchpriority="high">
      <figcaption>Yale University <span>New Haven, CT</span></figcaption>
    </figure>
  </section>
  <section class="home-section" aria-labelledby="research-title">
    <div class="section-heading"><h2 id="research-title">Research</h2><p>Methods &amp; questions</p></div>
    <div class="research-directions">
      <div><span class="research-number" aria-hidden="true">01</span><h3>Generative dynamics</h3><p>Continuous-time models that learn trajectories from sparse and irregular observations.</p></div>
      <div><span class="research-number" aria-hidden="true">02</span><h3>Geometry &amp; representation</h3><p>Optimal transport and learned representations that respect the structure of biological data.</p></div>
      <div><span class="research-number" aria-hidden="true">03</span><h3>Cells, perturbations &amp; time</h3><p>Single-cell responses, cellular interactions, multi-omics, and longitudinal medical imaging.</p></div>
    </div>
  </section>
  {% if page.news and site.announcements.enabled %}
    <section class="home-section" aria-labelledby="news-title">
      <div class="section-heading"><h2 id="news-title">News</h2><a class="quiet-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a></div>
      <div>{% include news.liquid limit=true %}</div>
    </section>
  {% endif %}
  {% if page.selected_papers %}
    <section class="home-section" aria-labelledby="papers-title">
      <div class="section-heading"><h2 id="papers-title">Selected work</h2><a class="quiet-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a><p class="contribution-note">* Equal contribution<br>† Shared secondary contribution</p></div>
      <div>{% include selected_papers.liquid %}</div>
    </section>
  {% endif %}
  <section class="home-section education-section" aria-labelledby="education-title">
    <div class="section-heading"><h2 id="education-title">Education</h2></div>
    <div class="degrees">
      {% for degree in site.data.resume.education %}
        <div class="degree"><div><h3>{{ degree.institution | replace: '--', '–' }}</h3><p>{{ degree.studyType }} · {{ degree.area }}</p></div><span>{{ degree.endDate }}</span></div>
      {% endfor %}
    </div>
  </section>
</div>
