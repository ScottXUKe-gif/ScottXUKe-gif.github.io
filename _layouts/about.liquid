---
layout: default
---
<div class="academic-home" id="home">
  <section class="profile-intro" aria-labelledby="intro-title">
    <aside class="profile-sidebar" aria-label="Profile and contact information">
      <img class="profile-photo" src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Ke Xu" width="1924" height="1280" fetchpriority="high">
      <p class="profile-position">Ph.D. Student, Yale University</p>
      <p class="profile-contact"><a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a><br>New Haven, CT</p>
      <nav class="profile-links" aria-label="Academic profiles">
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.github_username }}">GitHub</a>
        <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">LinkedIn</a>
        <a href="{{ '/cv/' | relative_url }}">CV</a>
      </nav>
    </aside>
    <div class="profile-bio">
      <h1 id="intro-title">Ke Xu <span lang="zh">许可</span></h1>
      {{ content }}
    </div>
  </section>
  {% if page.news and site.announcements.enabled %}
    <section class="home-section" id="news" aria-labelledby="news-title">
      <h2 id="news-title">News <a class="section-more" href="{{ '/news/' | relative_url }}">All updates</a></h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}
  {% if page.selected_papers %}
    <section class="home-section" id="publications" aria-labelledby="papers-title">
      <h2 id="papers-title">Selected Publications <a class="section-more" href="{{ '/publications/' | relative_url }}">All publications</a></h2>
      <p class="contribution-note">* Equal contribution · † Shared secondary contribution</p>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}
  <section class="home-section" id="education" aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    <div class="degrees">
      {% for degree in site.data.resume.education %}
        <div class="degree"><div><h3>{{ degree.institution | replace: '--', '–' }}</h3><p>{{ degree.studyType }} in {{ degree.area }}</p></div><span>{{ degree.endDate }}</span></div>
      {% endfor %}
    </div>
  </section>
  <section class="home-section" id="service" aria-labelledby="service-title">
    <h2 id="service-title">Service</h2>
    <p>Reviewer for NeurIPS 2024 and ICLR 2025.</p>
  </section>
</div>
